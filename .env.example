# PostgreSQL
POSTGRES_DB=ledger_agent
POSTGRES_USER=ledger_agent
POSTGRES_PASSWORD=change-this-local-password
DATABASE_URL=postgresql+psycopg://ledger_agent:change-this-local-password@localhost:5433/ledger_agent

# Evidence source: local uses Agent seed PostgreSQL; java uses Java's read-only HTTP API.
EVIDENCE_PROVIDER=local
JAVA_PLATFORM_BASE_URL=http://host.docker.internal:8080
JAVA_PLATFORM_READ_API_KEY=
# JSON object, for example {"CASE-1001":{"result_id":"00000000-0000-0000-0000-000000000000","channel":"ALIPAY","rule_version":"RULE-ALIPAY-V1"}}
JAVA_CASE_ID_MAP={}

# Model runtime
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
MODEL_TIMEOUT_SECONDS=30
MODEL_MAX_OUTPUT_TOKENS=2048
MODEL_MAX_RETRIES=2
MAX_TOOL_CALLS=8
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# Web application
NEXT_PUBLIC_API_URL=http://localhost:2024
NEXT_PUBLIC_ASSISTANT_ID=reconciliation_agent

# Optional LangSmith tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ledger-reconciliation-agent
