# Docker development configuration is defined by the repository root .env.example.
DATABASE_URL=postgresql+psycopg://ledger_agent:change-this-local-password@localhost:5433/ledger_agent

# Model runtime
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
MODEL_TIMEOUT_SECONDS=30
MODEL_MAX_OUTPUT_TOKENS=2048
MODEL_MAX_RETRIES=2
MAX_TOOL_CALLS=8
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# Optional LangSmith tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ledger-reconciliation-agent
